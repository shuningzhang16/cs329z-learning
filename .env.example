# Optional local settings. Never commit .env.
# Model calls use Codex CLI's ChatGPT login: codex login
# No OpenRouter or OpenAI API key is required.

# Optional overrides
# CS329Z_GRADING_MODEL=gpt-5.6-sol # a model supported by your Codex ChatGPT login
# CS329Z_USER_MODEL=gpt-5.6-sol
# CS329Z_JUDGE_MODEL=gpt-5.6-sol
# CS329Z_REASONING_EFFORT=low # reasoning effort for models that accept it
# CS329Z_CODEX_TIMEOUT_SECONDS=180
# CS329Z_BUDGET_USD=25        # legacy ledger USD cap; cannot cap ChatGPT subscription usage
# CS329Z_EVAL_SLICE=5         # run live tests on the first N items only
